# =============================================================================
# WEBEX_PULL_REQ_BUDDY — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# === Webex bot ===========================================================
# Create a bot at https://developer.webex.com/my-apps/new/bot
WEBEX_BOT_TOKEN=your_webex_bot_token_here

# Room ID where the bot announces user joins / broadcasts.
# Find it via: GET https://webexapis.com/v1/rooms (Bearer = bot token)
WEBEX_ROOM_ID=your_room_id_here

# === GitHub Enterprise ==================================================
# Base URL of the GitHub Enterprise REST API.
# Examples:
#   https://github.example.com/api/v3   (Enterprise Server)
#   https://api.github.com               (github.com SaaS — note: most code paths
#                                         assume Enterprise, see README caveats)
GITHUB_BASE_URL=https://github.example.com/api/v3

# Admin / fallback PAT used by the bot itself for unauthenticated polls
# (e.g. monitoring PRs before per-user PATs are registered). Each user
# registers their own PAT via DM `register <pat>` — that is preferred.
# Scope: `repo` (read + write).
GITHUB_TOKEN=your_admin_github_pat_here

# === User store encryption ==============================================
# Per-user GitHub PATs are stored encrypted at rest in `users.db` using
# symmetric Fernet encryption. Generate a key once with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat this like a database password — losing it makes existing users.db
# unreadable; rotating it requires re-registering every user.
ENCRYPTION_KEY=

# === Bot admin / access control =========================================
# Email of the bot admin (receives privileged DMs, e.g. `users` listing).
ADMIN_EMAIL=admin@example.com

# Optional comma-separated allowlist. If set, only these users can register.
# Leave blank to allow anyone in the room.
# ALLOWED_USERS=alice@example.com,bob@example.com

# === Defaults ===========================================================
# Default parent repo for `raise_hash_update`. Bare names are expanded to
# `myorg/<name>` (org name is hardcoded in bot.py — adjust there if needed).
# DEFAULT_REPO=buildimage

# Default PR for the legacy single-PR monitor (if you use that mode).
# DEFAULT_PR_URL=https://github.example.com/myorg/buildimage/pull/3473

# Polling interval (seconds) for the Webex message dispatcher. Default 600.
POLL_INTERVAL_SECONDS=300

# === Jenkins (optional) =================================================
# Enables `jenkins_last` / `jenkins_build` bot commands.
# Create a user API token in Jenkins → your user → Configure → API Token.
# JENKINS_BASE_URL=https://jenkins.example.com
# JENKINS_USER=your_jenkins_username
# JENKINS_API_TOKEN=your_jenkins_api_token
